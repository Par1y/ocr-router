server:
  host: "0.0.0.0"
  port: 8080

storage:
  base_dir: "./ocr_output"
  format: "both" # text, json, both

# PDF 输入支持。
# 启用后，CLI/API 可直接识别 .pdf 文件：项目会把每页栅格化为图片，
# 依次交给已有 OCR Provider，再拼接为完整文本。
# 渲染工具按以下顺序探测：显式 bin_path → 项目 ./bin/ → 系统 PATH。
# 若探测不到会打印相应安装命令提示。
pdf:
  enabled: true
  # 渲染器：留空自动探测（pdftoppm 优先，其次 mutool）。
  tool: ""          # "" | "pdftoppm" | "mutool"
  bin_path: ""      # 渲染器二进制绝对/相对路径，留空走 PATH
  info_bin_path: "" # pdfinfo 路径，留空走 PATH（仅用于页数统计）
  dpi: 200          # 渲染分辨率，越大越清晰也越慢
  max_pages: 0      # 最多渲染页数，0 = 不限制
  format: "png"     # 渲染格式：png 或 jpeg
  jpeg_quality: 85  # 当 format=jpeg 时生效
  temp_dir: ""      # 渲染临时目录，留空 = 系统默认
  window_size: 20   # 滑动窗口页数：大 PDF 每次最多在磁盘上驻留的渲染页数

providers:
  nvidia:
    type: "nvidia"
    enabled: true
    api_key: "${NVIDIA_API_KEY}"
    endpoint: "https://ai.api.nvidia.com/v1/cv/nvidia/nemotron-ocr-v2"
    max_b64_len: 180000

  llm_vision:
    type: "llm_vision"
    enabled: true
    api_key: "${STEP_API_KEY}"
    endpoint: "https://api.stepfun.com/step_plan/v1/chat/completions"
    model: "step-router-v1"
    prompt: "Extract all text from this image. Return only the text content."
    max_tokens: 16384

  browser_sse:
    type: "browser_sse"
    enabled: true
    base_url: "https://dotsocr.xiaohongshu.com"
    endpoints:
      upload: "/gradio_api/upload"
      submit: "/gradio_api/queue/join"
      sse: "/gradio_api/queue/data"
    headers:
      User-Agent: "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/151.0.0.0 Safari/537.36"

evaluator:
  enabled: true
  endpoint: "https://api.stepfun.com/step_plan/v1/chat/completions"
  api_key: "${STEP_API_KEY}"
  model: "step-router-v1"
  threshold: 0.7
  max_retries: 3
  retry_delay: "1s"
  timeout: "30s"
  max_tokens: 16384  # 思维链模型需要更多token给reasoning+content
  reasoning_effort: "medium"  # low, medium, high - 控制模型推理深度
  prompt: |
    You are an OCR quality evaluator. Please evaluate the quality of the following OCR result.

    OCR Result:
    {{ocr_result}}

    Evaluate on these criteria:
    1. Completeness (0-1): Is the text complete? Any missing content?
    2. Accuracy (0-1): Are there any recognition errors?
    3. Readability (0-1): Is the result easy to read and understand?

    Return JSON format:
    {
      "score": 0.85,
      "reason": "Brief explanation of the score",
      "details": {
        "completeness": 0.9,
        "accuracy": 0.8,
        "readability": 0.85
      }
    }

fallback:
  strategy: "sequential" # sequential, random
  max_retries: 3
  retry_delay: "2s"
  providers:
    - name: "nvidia"
      priority: 1
      enabled: true
    - name: "llm_vision"
      priority: 2
      enabled: true
    - name: "browser_sse"
      priority: 3
      enabled: true

task:
  workers: 5
  queue_size: 100
  task_timeout: "300s"

logging:
  level: "info" # debug, info, warn, error
  file: "./logs/ocr.log"
  format: "json" # json, text
  log_fallback: true
